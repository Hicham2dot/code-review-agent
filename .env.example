# NVIDIA API Configuration (required for LLM analysis)
NVIDIA_API_KEY=sk-your-nvidia-api-key-here

# Optional: LLM Configuration
LLM_MODEL=google/gemma-3n-e2b-it
LLM_ENABLED=true

# Optional: Cache Configuration
CACHE_DIR=~/.cache/code-review-agent
CACHE_TTL=86400

# Optional: Config File
CONFIG_FILE=.code-review-agent.yml
